# ── CamSense AI · Frontend environment ────────────────────────────
# Copy to `.env`. Only VITE_-prefixed vars are exposed to the browser,
# so NEVER put secrets (JWT secret, DB creds, API keys) here.

# Base URL of the Node backend API. The frontend talks ONLY to the backend,
# never to the Python AI service directly.
VITE_API_BASE_URL=http://localhost:5000/api
